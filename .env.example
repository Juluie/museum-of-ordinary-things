# ===================================================================
# ЧАСТЬ 1. ПЕРЕМЕННЫЕ САЙТА (браузер)
# Копируй в .env.local для локальной разработки
# или задай в Cloudflare Pages → Settings → Variables and Secrets.
#
# ВНИМАНИЕ: всё с префиксом VITE_ попадает в собранный сайт и видно
# любому посетителю. Сюда можно класть ТОЛЬКО публичные значения.
# ===================================================================

# demo — вымышленные экспонаты, отправка ничего не сохраняет (по умолчанию)
# live — настоящий музей на Supabase
VITE_APP_MODE=demo

# Адрес проекта Supabase: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable-ключ (начинается с sb_publishable_). НЕ секретный ключ.
# Если вставить сюда sb_secret_… — сайт откажется запускаться.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Публичный site key Cloudflare Turnstile (не secret key)
VITE_TURNSTILE_SITE_KEY=

# true — показывать форму отправки в live-режиме. По умолчанию выключено.
# Реальный приём включается ещё и на сервере (SUBMISSIONS_ENABLED ниже).
VITE_SUBMISSIONS_ENABLED=false


# ===================================================================
# ЧАСТЬ 2. СЕКРЕТЫ СЕРВЕРА (Supabase Edge Functions)
# НЕ кладутся в Cloudflare и НЕ попадают в браузер.
# Задаются командой `supabase secrets set ИМЯ=значение`
# или в панели Supabase → Edge Functions → Secrets.
# Для локального запуска функций — supabase/functions/.env (в .gitignore).
#
# SUPABASE_URL и секретный ключ (SUPABASE_SECRET_KEYS /
# SUPABASE_SERVICE_ROLE_KEY) Supabase подставляет функциям сам —
# задавать их вручную не нужно.
# ===================================================================

# Главный выключатель приёма. По умолчанию false — приём закрыт.
# SUBMISSIONS_ENABLED=false

# Секретный ключ Turnstile (из панели Cloudflare → Turnstile)
# TURNSTILE_SECRET_KEY=

# Домены сайта через запятую — Turnstile-токен с другого домена не примется
# TURNSTILE_EXPECTED_HOSTNAMES=example.pages.dev,museum.example.com

# Случайная строка от 32 символов для обезличивания IP в лимитах.
# Сгенерировать: openssl rand -hex 32
# RATE_LIMIT_HMAC_SECRET=
# RATE_LIMIT_HMAC_KEY_VERSION=v1

# С каких адресов сайта разрешены запросы (CORS), через запятую
# ALLOWED_ORIGINS=https://example.pages.dev,https://museum.example.com

# Лимиты отправки
# SUBMIT_LIMIT_PER_HOUR=3
# SUBMIT_LIMIT_PER_DAY=10
# SUBMIT_LIMIT_GLOBAL_PER_DAY=100

# Ограничения фото на сервере
# MAX_UPLOAD_BYTES=6291456
# MAX_SERVER_PIXELS=12000000

# Срок жизни временных ссылок на фото, секунды
# PUBLIC_SIGNED_URL_TTL_SECONDS=3600
# ADMIN_SIGNED_URL_TTL_SECONDS=600
